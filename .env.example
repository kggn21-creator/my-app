# ============================================================
# 환경변수 예시 파일 — 실제 값은 절대 커밋하지 마세요.
# 사용법: 이 파일을 .env 로 복사한 뒤 각 값을 채워주세요.
#   cp .env.example .env
# ============================================================

# NeonDB Connection Pooling URL (앱 런타임 — Vercel/서버리스 환경에서 사용)
# 출처: NeonDB 대시보드 → 프로젝트 → Connection string → Pooled connection
DATABASE_URL=""

# NeonDB Direct URL (prisma migrate 전용 — 마이그레이션 시에만 사용)
# 출처: NeonDB 대시보드 → 프로젝트 → Connection string → Direct connection
DIRECT_URL=""

# NextAuth.js 세션 서명 비밀키 (32바이트 이상 랜덤 문자열)
# 생성 방법: openssl rand -base64 32
AUTH_SECRET=""

# 애플리케이션의 공개 URL (로컬: http://localhost:3000, 배포: https://your-domain.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
