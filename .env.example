# ============================================================
# 환경변수 예시 파일 — 실제 값은 절대 커밋하지 마세요.
# 사용법: 이 파일을 .env 로 복사한 뒤 각 값을 채워주세요.
#   cp .env.example .env
# ============================================================

# [로컬 개발] SQLite 파일 경로 (로컬 전용)
# [프로덕션] NeonDB 또는 Supabase의 Connection Pooling 문자열
# 예: postgresql://user:password@host/dbname?pgbouncer=true
DATABASE_URL="file:./prisma/dev.db"

# NextAuth.js 세션 서명 비밀키
# 생성 방법: openssl rand -base64 32
AUTH_SECRET=""

# 애플리케이션의 공개 URL (로컬: http://localhost:3000, 배포: https://your-domain.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
