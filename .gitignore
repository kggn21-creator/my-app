# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 값이 담긴 파일은 절대 커밋 금지
.env
.env.local
.env*.local
# .env.example 은 커밋 허용 (값 없는 키 목록)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# SQLite DB files (로컬 개발 전용 — 절대 커밋 금지)
*.db
*.db-shm
*.db-wal
/prisma/dev.db
/prisma/*.db

# uploads (사용자 업로드 파일)
/public/uploads/
